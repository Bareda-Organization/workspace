{
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "env": {
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force",
    "GATEGUARD_BASH_ROUTINE_DISABLED": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "footerLinksRegexes": [
    "graft/[\\w./-]+\\.md"
  ],
  "permissions": {
    "allow": [
      "Bash(graft:*)",
      "Bash(npx graft:*)",
      "Bash(graft-dev:*)",
      "Bash(node dist/cli.js:*)",
      "Bash(orca orchestration:*)",
      "Bash(orca worktree:*)",
      "Bash(orca terminal:*)"
    ]
  },
  "includeCoAuthoredBy": false
}
